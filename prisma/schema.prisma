generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model ContentPost {
  id         String   @id @default(cuid())
  title      String
  summary    String   @db.Text
  body       String   @db.LongText
  country    String
  category   String
  tags       String   @db.Text
  language   String   @default("ko")
  visibility String   @default("PUBLIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([country, category, visibility])
  @@index([createdAt])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userEmail String
  action    String   // "video_ai_use" | "paywall_shown" | "paywall_cta_click" | "paywall_dismiss"
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userEmail, action])
  @@index([createdAt])
}

model Institution {
  id        String   @id
  nameKo    String
  nameEn    String
  aliases   String   @db.Text
  city      String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents InstitutionDocument[]
  knowledge InstitutionKnowledge[]
  sources   InstitutionSource[]
  members   OrganizationMember[]
  endUsers  EndUserOrganization[]
}

model InstitutionDocument {
  id            String   @id @default(cuid())
  institutionId String
  title         String
  category      String
  fileName      String
  mimeType      String
  extractedText String   @db.LongText
  status        String   @default("processing")
  errorMessage  String?  @db.Text
  uploadedBy    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  knowledge   InstitutionKnowledge[]
  sources     InstitutionSource[]

  @@index([institutionId, createdAt])
}

model InstitutionKnowledge {
  id             String   @id @default(cuid())
  institutionId  String
  documentId     String?
  category       String
  title          String
  summary        String   @db.Text
  factsJson      String   @db.LongText
  documentsJson  String   @db.Text
  whereToJson    String   @db.Text
  keywordsJson   String   @db.Text
  source         String
  verified       Boolean  @default(false)
  publicDataNote String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  document    InstitutionDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([institutionId, verified])
  @@index([institutionId, category])
}

model InstitutionSource {
  id            String   @id @default(cuid())
  institutionId String
  label         String
  url           String   @db.VarChar(500)
  status        String   @default("idle")
  errorMessage  String?  @db.Text
  documentId    String?
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  document    InstitutionDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([institutionId, url])
  @@index([institutionId, status])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("ORG_VIEWER")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Institution @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, status])
}

model EndUserOrganization {
  id             String    @id @default(cuid())
  email          String
  organizationId String
  status         String    @default("ACTIVE")
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Institution @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([email, organizationId])
  @@index([organizationId, status])
  @@index([email])
}

model AuthUser {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String?  @db.VarChar(255)
  provider         String?
  providerAccountId String?
  status           String   @default("ACTIVE")
  marketingAgreed  Boolean  @default(false)
  thirdPartyAgreed Boolean  @default(false)
  passwordMustChange Boolean @default(false)
  accountType      String   @default("END_USER")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([status])
  @@index([accountType])
}

model AuthChallenge {
  id         String    @id @default(cuid())
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorEmail     String
  actorType      String
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorEmail, createdAt])
}

/// 내부 콘솔: 외부 자료 제공처 (공공기관·대학·전문가 등). 파트너 계정 없음.
model KnowledgeProvider {
  id          String   @id @default(cuid())
  name        String
  /// PUBLIC_AGENCY | UNIVERSITY | FOREIGNER_SUPPORT | PARTNER | EXPERT | OTHER
  type        String
  domain      String   @default("")
  region      String   @default("")
  description String?  @db.Text
  /// ACTIVE | INACTIVE
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets KnowledgeAsset[]

  @@index([type, status])
  @@index([name])
}

/// 내부 콘솔: 검증 대기→승인→지식베이스 반영 워크플로 자료.
model KnowledgeAsset {
  id                  String    @id @default(cuid())
  title               String
  providerId          String
  /// housing | stay | hospital | campus | bank | other
  domain              String
  region              String    @default("")
  /// optional Institution.id
  institutionId       String?
  /// PDF | DOCUMENT | URL | TEXT
  sourceType          String
  contentText         String    @db.LongText
  sourceUrl           String?   @db.VarChar(500)
  fileName            String?
  mimeType            String?
  originalPublishedAt DateTime?
  originalUpdatedAt   DateTime?
  reviewerEmail       String?
  reviewMemo          String?   @db.Text
  /// PENDING_REVIEW | APPROVED | PUBLISHED | ON_HOLD | INACTIVE
  status              String    @default("PENDING_REVIEW")
  version             Int       @default(1)
  publishedAt         DateTime?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  provider  KnowledgeProvider         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  versions  KnowledgeAssetVersion[]
  opinions  ExpertOpinion[]

  @@index([status, domain])
  @@index([providerId])
  @@index([institutionId, status])
  @@index([updatedAt])
}

model KnowledgeAssetVersion {
  id         String   @id @default(cuid())
  assetId    String
  version    Int
  snapshot   String   @db.LongText
  changedBy  String
  changeNote String?  @db.Text
  createdAt  DateTime @default(now())

  asset KnowledgeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@index([assetId, createdAt])
}

/// 외부 전문가 의견 — 내부 관리자가 대행 등록 (전문가 로그인 없음).
model ExpertOpinion {
  id            String   @id @default(cuid())
  expertName    String
  affiliation   String   @default("")
  domain        String   @default("")
  assetId       String?
  opinion       String   @db.LongText
  receivedAt    DateTime @default(now())
  applied       Boolean  @default(false)
  internalMemo  String?  @db.Text
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  asset KnowledgeAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([domain, applied])
  @@index([assetId])
  @@index([receivedAt])
}
